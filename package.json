{
  "name": "eventia",
  "version": "1.0.0",
  "private": true,
  "description": "Eventia · plataforma de eventos de Abancay (API Express + React). Esta raíz se usa para desplegar en Vercel.",
  "scripts": {
    "build": "npm --prefix client run build && node scripts/copy-demo-uploads.js",
    "start": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/blob": "2.4.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.14",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4"
  }
}
