# ===== Eventia - plantilla de configuración =====
# Copia este archivo como server/.env (local). En Vercel define las mismas variables en
# Project Settings → Environment Variables. Nunca subas el archivo .env al repositorio.

PORT=4000
NODE_ENV=development
# URL pública con la que se abren los enlaces y los códigos QR (en Vercel: https://tu-proyecto.vercel.app)
PUBLIC_URL=http://localhost:4000

# --- Base de datos: elige UNA de las dos opciones ---
# Opción A (local, Windows): SQL Server Express por ODBC con autenticación de Windows (no requiere TCP/IP)
DB_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=.\SQLEXPRESS01;Database=EventiaDB;Trusted_Connection=yes;
# Opción B (nube / Vercel): SQL Server accesible por TCP, p. ej. Azure SQL Database. Si DB_SERVER tiene valor, se usa esta.
DB_SERVER=
DB_PORT=1433
DB_NAME=EventiaDB
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true

JWT_SECRET=cambia-esto-por-un-secreto-largo

# Correo (SMTP). Sin SMTP los códigos solo se ven en pantalla en desarrollo.
# Gratis con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu Gmail personal y SMTP_PASS=una
# "contraseña de aplicación" de 16 letras (myaccount.google.com/apppasswords; requiere verificación en dos pasos).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Eventia <no-reply@eventia.pe>
# En producción sin SMTP, DEMO_MODE=true muestra los códigos de verificación en pantalla (solo para presentaciones)
DEMO_MODE=false

# Vercel: secreto para la tarea diaria /api/cron y token de Vercel Blob para subir imágenes
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=

# Cuenta del administrador creada por "npm run seed"
ADMIN_NAME=Administrador Eventia
ADMIN_EMAIL=admin@eventia.local
ADMIN_PASSWORD=define-una-contrasena-segura

# Contraseña de las cuentas de demostración (organizador@eventia.local, usuario@eventia.local)
DEMO_PASSWORD=define-una-contrasena

# Opcional: "Continuar con Google". Client ID web de Google Cloud (es público; no hace falta el secreto).
# Orígenes autorizados: tu dominio de Vercel y http://localhost:4000
GOOGLE_CLIENT_ID=
